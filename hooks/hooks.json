{
  "description": "Install the gh-arriba extension that the GitHub commands call",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/install-gh-arriba.sh"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
